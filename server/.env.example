# ── Server ────────────────────────────────────────────────────
PORT=8000

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=change_this_to_a_long_random_secret_string

# ── Database ──────────────────────────────────────────────────
# SQLite (default — works out of the box, no extra setup):
DATABASE_URL=file:./dev.db

# PostgreSQL (production — uncomment and fill in when available):
# DATABASE_URL=postgresql://username:password@localhost:5432/plateai
