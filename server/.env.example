# ── Server ────────────────────────────────────────────────────
PORT=8000

# ── JWT (required — change before any shared/prod deploy) ─────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
# ALLOW_INSECURE_DEV=true

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://username:password@localhost:5432/plateai

# ── Core gRPC (private AI worker) ─────────────────────────────
CORE_GRPC_URL=127.0.0.1:50051
# CORE_GRPC_USE_TLS=true

# ── Limits / abuse controls ───────────────────────────────────
JSON_BODY_LIMIT=12mb
STT_MAX_AUDIO_BYTES=15728640
AUTH_RATE_MAX=30
AUTH_RATE_WINDOW_MS=900000
AI_RATE_MAX=40
AI_RATE_WINDOW_MS=60000
# TRUST_PROXY=true
# HEALTH_EXPOSE_CORE_URL=false

# ── CORS (production: explicit origins) ───────────────────────
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
