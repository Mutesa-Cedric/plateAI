# ── IBM Watson Text-to-Speech ─────────────────────────────────
TEXT_TO_SPEECH_IBM_API_KEY=your_ibm_tts_api_key_here
TEXT_TO_SPEECH_IBM_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/your_instance_id

# ── IBM Watson Speech-to-Text ─────────────────────────────────
SPEECH_TO_TEXT_IBM_API_KEY=your_ibm_stt_api_key_here
SPEECH_TO_TEXT_IBM_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/your_instance_id

# ── Groq ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── gRPC (private — bind loopback so only co-located server can reach core)
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_MAX_WORKERS=20
# Max in-memory STT audio (bytes)
STT_MAX_AUDIO_BYTES=15728640
# Opt-in only: log truncated body previews (may contain health/PII) — keep False in prod
LOG_SENSITIVE_PREVIEWS=False

# ── App ───────────────────────────────────────────────────────
DEBUG=True
